{
  "manifest_version": 3,
  "name": "GhostPush — AI Code Repository Sync",
  "version": "1.0.0",
  "description": "Auto-sync your competitive programming solutions to GitHub with AI-generated READMEs.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "ws://127.0.0.1:8000/*",
    "https://leetcode.com/*",
    "https://*.geeksforgeeks.org/*",
    "https://codeforces.com/*",
    "https://*.hackerrank.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GhostPush"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://codeforces.com/*",
        "https://*.hackerrank.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
